# 萌幻ACG登录凭据（复制为.env并填入真实值，.env不要提交到git）
ACGRX_EMAIL=your_email@example.com
ACGRX_PASSWORD=your_password_here

# 鲲Galgame(kungal.com) 会话cookie：下载链接接口需要登录
# 获取方式：浏览器登录 kungal.com（走 NextMoe·未萌 授权）后，从 cookies 里取 kungal_session
# 只填 "kungal_session=xxxx" 这一段即可；约 90 天滑动有效，失效后重新登录更新
KUNGAL_COOKIE=kungal_session=your_session_here

# NextMoe·未萌 账号：供 tools/refresh_kungal_cookie.py 自动重新登录并刷新上面的 cookie
NEXTMOE_NAME=your_account
NEXTMOE_PASSWORD=your_password_here
